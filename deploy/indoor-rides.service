[Unit]
Description=Garmin indoor ride distance fixer (Discord bot)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/strava-indoor-rides
ExecStart=/home/pi/strava-indoor-rides/.venv/bin/indoor-rides run
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
