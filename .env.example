# Copy to .env and fill in. Keep .env private (chmod 600 .env).

# --- Garmin Personal API ------------------------------------------------------
# Create at https://connect.garmin.com/app/settings/personalApiToken (choose 1 year)
GARMIN_API_KEY=
# Optional: the key's expiry date, so the bot can remind you 2 weeks before.
GARMIN_KEY_EXPIRES=2027-10-31

# --- Strava API app -------------------------------------------------------------
# From https://www.strava.com/settings/api
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Optional: Strava gear id (e.g. b1234567) to set on fixed indoor rides.
# `indoor-rides strava-auth` prints your bikes' ids.
STRAVA_INDOOR_GEAR_ID=

# --- Discord ---------------------------------------------------------------------
DISCORD_BOT_TOKEN=
# Your own Discord user id (Settings → Advanced → Developer Mode, then right-click yourself → Copy User ID)
DISCORD_USER_ID=

# --- Behaviour -------------------------------------------------------------------
# Garmin activity types that get the distance prompt (comma separated).
# Run `indoor-rides garmin-list` to see what your rides are called.
INDOOR_ACTIVITY_TYPES=indoor_cycling
# Upload every other activity to Strava unchanged (needed once Garmin's own Strava sync is off).
FORWARD_OTHER_ACTIVITIES=true
# mi or km
DISTANCE_UNITS=mi
# How entered average watts are written into the file:
#   constant = same wattage every second (flat graph)
#   cadence  = scaled by cadence, 0 W when coasting (realistic-looking graph)
POWER_MODE=constant
POLL_MINUTES=5
DATA_DIR=./data
